# Copy to terraform.tfvars and adjust only after inspecting the current GKE cluster.
project_id = "k8s-learning-510807"
region = "us-central1"
zone = "us-central1-a"
cluster_name = "gke-istio-lab"
# IMPORTANT: keep manage_gke_cluster=false until cluster import/config review is complete.
manage_gke_cluster = false
# IMPORTANT: creating a new custom VPC does not migrate an existing cluster to it.
# If the current cluster uses another network, keep create_network=false for adoption,
# or plan a deliberate cluster migration/replacement as a separate change.
create_network = false
